extends SceneTree
const BOARD := preload("res://scripts/command/coordination/deck_board.gd")
var failures := 0
var checks := 0
func _initialize() -> void: call_deferred("_run")
func _run() -> void:
	var g := BOARD.new()
	verify(g.fleet_task() and not g.fleet_task(),"single idempotent task")
	g.advance()
	verify(g.decks.A.now.id==1 and g.task.carrier=="A","fleet order received and assigned")
	verify(g.request_return("A",true) and g.request_return("B",false),"independent requests")
	var handle: int = g.takeover("A",g.USER)
	verify(g.decks.A.line.size()==1 and g.decks.A.now.id==1,"handoff preserves deck and queue")
	verify(not g.start("A",g.AUTO,0) and not g.start("A",g.USER,handle),"no stale access or overlapping work")
	g.advance()
	verify(not g.decks.B.now.is_empty() and g.decks.A.now.id==1,"B continues automatically")
	g.advance()
	verify(g.task.status=="已完成" and g.decks.A.now.is_empty(),"active ticket finishes under player")
	verify(g.captain_open("A",false) and not g.start("A",g.USER,handle),"ship closure overrides start")
	verify(g.captain_open("A",true) and g.start("A",g.USER,handle),"user can start when available")
	g.takeover("A",g.AUTO)
	verify(g.decks.A.now.id==2 and not g.start("A",g.USER,handle),"handoff invalidates stale permission")
	g.advance()
	g.advance()
	verify(g.decks.A.now.is_empty() and g.decks.B.now.is_empty(),"both queues drain")
	var h := BOARD.new()
	h.request_return("A",false)
	h.request_return("A",true)
	h.advance()
	verify(h.decks.A.now.id==2 and h.decks.A.line[0].id==1,"automatic priority and FIFO tie")
	var j := BOARD.new()
	j.captain_open("A",false)
	j.captain_open("B",false)
	j.fleet_task()
	j.request_return("A",false)
	for i: int in 13: j.advance()
	verify(j.task.status=="已过期" and j.decks.A.line.is_empty(),"blocked work expires")
	var k := BOARD.new()
	k.takeover("A",k.USER)
	k.fleet_task()
	k.advance()
	verify(k.decks.A.line.size()==1 and k.decks.A.now.is_empty(),"Assigned work awaits player release")
	k.captain_open("A",false)
	k.advance()
	verify(k.decks.A.line.is_empty() and k.decks.B.now.id==1 and k.task.carrier=="B","Reassign waiting ticket exactly once, preserving identity")
	print("DECK_BOARD checks=",checks," failures=",failures)
	quit(0 if failures==0 else 1)
func verify(ok: bool, title: String) -> void:
	checks+=1
	if not ok:
		failures+=1
		push_error(title)
